# Application Environment (development, production, testing)
APP_ENV=development
APP_NAME="iZone Technologies WhatsApp Automation"
LOG_LEVEL=INFO
DEBUG=True

# Meta WhatsApp Cloud API Settings
META_ACCESS_TOKEN=your_meta_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here
META_VERIFY_TOKEN=izone_meta_verify_token_secure_123

# Database URL (PostgreSQL)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://izone_user:your_password_here@localhost:5432/izone_bot

# CORS Origins (Comma-separated origins, or * to allow all origins)
CORS_ORIGINS=*

# Admin Security
ADMIN_API_KEY=izone_admin_secret_api_key_2026

# Company Information Defaults
COMPANY_NAME="iZone Technologies"
COMPANY_WEBSITE="https://izonetech.in/"
COMPANY_PHONE="+919940048776"
COMPANY_EMAIL="info@izonetech.in"
COMPANY_LOCATION_LATITUDE=10.8271
COMPANY_LOCATION_LONGITUDE=78.6890
COMPANY_ADDRESS="3rd Floor, Aruvi Arcade Complex, 5th Cross Thillainagar, North Extension Road, Tiruchirappalli, Tamil Nadu – 620018"
COMPANY_WORKING_HOURS="Monday – Saturday, 10:00 AM – 6:30 PM"

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=info@izonetech.in